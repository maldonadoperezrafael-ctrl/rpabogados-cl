<script>
  // Conexión del botón "Sede Pichilemu" del menú superior a la sección radial
  const navLinks = document.querySelectorAll('a');
  navLinks.forEach((link) => {
    const txt = (link.textContent || '').toUpperCase();
    if (txt.includes('PICHILEMU') && !link.id) {
      link.setAttribute('href', '#sede-pichilemu');
    }
  });

  // Base institucional de fallos judiciales verificados con URLs directas reales e imágenes autónomas
  const poolFallos = [
    { cat: 'Indemnizaciones', tag: 'Fallo Clave', title: 'Los jueces ya no pueden rebajar indemnizaciones «al ojo»: tienen que fundamentar cada peso del daño moral', desc: 'La justicia fijó un criterio claro: si un juez decide bajar el monto que una persona pide por daño moral, no puede escudarse en frases vagas.', url: 'https://www.diarioconstitucional.cl/videos/jueces-deben-explicar-fundadamente-por-que-reducen-el-monto-de-la-indemnizacion-de-perjuicios-por-dano-moral-mas-alla-de-una-somera-debilidad-probatoria/', source: 'Diario Constitucional', img: 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=600&q=80' },
    { cat: 'Redes Sociales', tag: 'Corte Suprema', title: 'La Suprema frena las «funas» en internet: prohibido acusar de delitos sin pruebas en redes sociales', desc: 'El máximo tribunal dejó en claro que nadie puede imputar delitos sin condena judicial, ordenando eliminar las publicaciones.', url: 'https://www.diarioconstitucional.cl/2026/04/21/corte-suprema-pone-freno-a-acusaciones-de-delitos-sin-respaldo-difundidas-en-redes-sociales/', source: 'Diario Constitucional', img: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80' },
    { cat: 'Libertad de Prensa', tag: 'Rol N° 7808-2026', title: 'No se pueden borrar noticias de juicios pasados invocando el «derecho al olvido»', desc: 'La Corte dictaminó que si la información fue real y de interés público, el derecho a informar de la prensa está primero.', url: 'https://www.diarioconstitucional.cl/2026/06/16/corte-suprema-descarta-eliminar-noticias-invocando-el-derecho-al-olvido/', source: 'Diario Constitucional', img: 'https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=600&q=80' },
    { cat: 'Fraudes Bancarios', tag: 'Ley 20.009', title: 'Bancos deben restituir fondos defraudados en 5 días hábiles y no pueden culpar al cliente sin demanda judicial', desc: 'Las Cortes ratifican que las entidades financieras no pueden negarse unilateralmente al reembolso de hasta 35 UF alegando negligencia del usuario.', url: 'https://www.diarioconstitucional.cl/2025/06/17/corte-suprema-confirma-fallo-que-obliga-a-banco-a-restituir-fondos-por-fraude-electronico/', source: 'Diario Constitucional', img: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=600&q=80' },
    { cat: 'Derecho Inmobiliario', tag: 'Ley 21.633', title: 'Usurpación de terrenos constituye delito en flagrancia permanente que habilita desalojo inmediato con fuerza pública', desc: 'Los juzgados de garantía están facultados para decretar la restitución provisoria del inmueble ocupado ilegalmente en cualquier momento.', url: 'https://www.diarioconstitucional.cl/articulos/algunas-reflexiones-sobre-la-nueva-ley-n-21-633-que-regula-los-delitos-de-ocupacion-ilegal-de-inmuebles-y-los-efectos-de-la-medida-cautelar-real-especial-incorporada-en-dicho-articulado/', source: 'Actualidad Jurídica', img: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=600&q=80' },
    { cat: 'Responsabilidad', tag: 'Corte Suprema', title: 'Abogado que deja vencer plazos fatales o abandona el procedimiento debe indemnizar la pérdida de la chance', desc: 'El máximo tribunal condena civilmente a letrados negligentes por frustrar la oportunidad legítima de obtener sentencia favorable.', url: 'https://www.diarioconstitucional.cl/2026/01/06/corte-de-santiago-fija-indemnizacion-de-120-millones-contra-clinica-por-perdida-de-oportunidad-tras-manejo-negligente-de-acv/', source: 'Poder Judicial / CS', img: 'https://images.unsplash.com/photo-1505664194779-8beaceb93744?auto=format&fit=crop&w=600&q=80' }
  ];

  // Motor estricto de rotación automática basada en ciclos exactos de 10 días corridos
  const DIEZ_DIAS_MS = 1000 * 60 * 60 * 24 * 10;
  const cicloDiezDias = Math.floor(Date.now() / DIEZ_DIAS_MS);
  let currentIndex = (cicloDiezDias * 3) % poolFallos.length;

  function renderFallos() {
    for (let i = 0; i < 3; i++) {
      const item = poolFallos[(currentIndex + i) % poolFallos.length];
      const catEl = document.getElementById('news-cat-' + i);
      const tagEl = document.getElementById('news-tag-' + i);
      const linkEl = document.getElementById('news-link-' + i);
      const descEl = document.getElementById('news-desc-' + i);
      const srcEl = document.getElementById('news-source-' + i);
      const moreEl = document.getElementById('news-more-' + i);
      const imgEl = document.getElementById('news-img-' + i) as HTMLImageElement;

      if (catEl && tagEl && linkEl && descEl) {
        catEl.textContent = item.cat;
        tagEl.textContent = item.tag;
        linkEl.textContent = item.title;
        linkEl.setAttribute('href', item.url);
        descEl.textContent = item.desc;
        if (srcEl) srcEl.textContent = item.source;
        if (moreEl) moreEl.setAttribute('href', item.url);
        if (imgEl && item.img) imgEl.setAttribute('src', item.img);
      }
    }
  }

  renderFallos();

  const btnRotar = document.getElementById('btn-rotar-fallos');
  if (btnRotar) {
    btnRotar.addEventListener('click', () => {
      currentIndex = (currentIndex + 3) % poolFallos.length;
      renderFallos();
    });
  }
</script>
