        source: 'Diario Constitucional',
        img: '/fotos/area-civil.webp'
      }
    ];

    var DIEZ_DIAS_MS = 1000 * 60 * 60 * 24 * 10;
    var ciclo = Math.floor(Date.now() / DIEZ_DIAS_MS);
    var currentIndex = (ciclo * 3) % poolFallos.length;

    function renderFallos() {
      for (var i = 0; i < 3; i++) {
        var item = poolFallos[(currentIndex + i) % poolFallos.length];
        var catEl = document.getElementById('news-cat-' + i);
        var tagEl = document.getElementById('news-tag-' + i);
        var linkEl = document.getElementById('news-link-' + i);
        var descEl = document.getElementById('news-desc-' + i);
        var srcEl = document.getElementById('news-source-' + i);
        var moreEl = document.getElementById('news-more-' + i);
        var imgEl = document.getElementById('news-img-' + i);

        if (catEl && tagEl && linkEl && descEl) {
          catEl.textContent = item.cat;
          tagEl.textContent = item.tag;
          linkEl.textContent = item.title;
          linkEl.setAttribute('href', item.url);
          descEl.textContent = item.desc;
          if (srcEl) srcEl.textContent = item.source;
          if (moreEl) moreEl.setAttribute('href', item.url);
          if (imgEl && item.img) imgEl.setAttribute('src', item.img);
        }
      }
    }

    renderFallos();

    var btnRotar = document.getElementById('btn-rotar-fallos');
    if (btnRotar) {
      btnRotar.addEventListener('click', function() {
        currentIndex = (currentIndex + 3) % poolFallos.length;
        renderFallos();
      });
    }
  })();
</script>
