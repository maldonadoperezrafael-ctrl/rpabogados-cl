---
import Layout from '../layouts/Layout.astro';
import MapaGoogle from '../components/MapaGoogle.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
---

<Layout title="RP Abogados | Litigación Estratégica & Derecho Público | Santiago, Chile">
  <Header />

  <main class="pt-0">
    <!-- Hero Section -->
    <section id="inicio" class="relative min-h-[90vh] flex items-end overflow-hidden bg-[#181a1f]">
      <div class="absolute inset-0">
        <img 
          src="/fotos/fondo-hormigon.webp" width="1920" height="1282" fetchpriority="high" decoding="async"
          alt=""
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div>
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-20 pt-24">
        <div class="max-w-3xl">
          <h1 class="font-cormorant text-white text-6xl md:text-8xl lg:text-9xl font-semibold leading-[0.9] mb-6 tracking-normal drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
            RP<br />ABOGADOS
          </h1>

          <div class="w-24 h-1 bg-oro mb-8 shadow-md"></div>

          <p class="text-white/95 text-lg md:text-xl font-normal leading-relaxed max-w-2xl drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">
            Estudio jurídico orientado en litigación de alta complejidad, en juicios de derechos de daños, en delitos penales económicos-tributarios y de alta connotación social, contencioso administrativos, acciones constitucionales, derecho migratorio y derecho laboral de la empresa colectivo e individual. Desde Santiago y la Región de O'Higgins, asesoramos a personas, empresas e instituciones en los casos más desafiantes, con un enfoque estratégico, ético y orientado a resultados.
          </p>

          <a
            href="https://www.radiocorporacionpichilemu.net/"
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-8 inline-flex min-h-16 w-[calc(100%-4.5rem)] max-w-full items-center gap-4 bg-oro px-5 py-3 text-tinta no-underline shadow-[0_10px_30px_rgba(0,0,0,0.28)] transition-colors duration-200 hover:bg-oro-claro focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro-claro sm:w-auto"
            aria-label="Escuchar Radio Corporación 97.7 FM en vivo, en una pestaña nueva"
          >
            <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="m10 8 6 4-6 4Z" fill="currentColor" stroke="none"></path>
            </svg>
            <span class="min-w-0">
              <span class="block text-sm font-bold leading-tight">Escucha «La Ley sin Letra Chica»</span>
              <span class="mt-1 block text-xs font-semibold leading-tight">Miércoles y viernes · 11:30 hrs · 97.7 FM</span>
            </span>
            <svg class="ml-1 hidden h-5 w-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Nuestra Filosofía -->
    <section class="py-14 bg-slate-50 border-t border-b border-slate-200" id="filosofia">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Nuestra Filosofía</h2>
          <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-3"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-7 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
            <span class="text-4xl md:text-5xl font-bold text-oro-oscuro block mb-3 tracking-tight">01</span>
            <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">Dirección Personalizada de Cada Causa</h3>
            <div class="w-8 h-0.5 bg-slate-200 mb-3"></div>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Conducción directa y estratégica de cada litigio a cargo de los socios de la firma, integrando análisis crítico y visión multidisciplinaria en cada etapa procesal.
            </p>
          </div>

          <div class="bg-white p-7 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
            <span class="text-4xl md:text-5xl font-bold text-oro-oscuro block mb-3 tracking-tight">02</span>
            <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">Fundamentación y Precisión Técnica</h3>
            <div class="w-8 h-0.5 bg-slate-200 mb-3"></div>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Construcción de argumentos de alto estándar técnico sustentados en el análisis exhaustivo de legislación especializada, doctrina y jurisprudencia consolidada.
            </p>
          </div>

          <div class="bg-white p-7 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
            <span class="text-4xl md:text-5xl font-bold text-oro-oscuro block mb-3 tracking-tight">03</span>
            <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">Comunicación Permanente y Confidencialidad</h3>
            <div class="w-8 h-0.5 bg-slate-200 mb-3"></div>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Información continua y transparente sobre los avances y escenarios de cada causa, bajo el más estricto resguardo ético y reserva profesional.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Barra de Datos -->
    <section class="bg-[#12151B] text-white py-10 border-t border-b border-white/10">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-3xl md:text-4xl font-light text-[#C5A880] mb-1">15+</div>
            <div class="text-xs md:text-sm text-white/70">Años de Trayectoria Jurídica</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-light text-[#C5A880] mb-1">TS</div>
            <div class="text-xs md:text-sm text-white/70">Suprema, Cortes y TC</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-light text-[#C5A880] mb-1">100%</div>
            <div class="text-xs md:text-sm text-white/70">Conducción Directa de Socios</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-light text-[#C5A880] mb-1">RM-VI</div>
            <div class="text-xs md:text-sm text-white/70">Santiago y Región de O'Higgins</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Presencia regional: sentencia destacada y programa radial -->
    <section id="presencia-regional" class="regional-grid scroll-mt-20 border-y border-white/10 py-16 text-white md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <span class="mb-3 block text-xs font-bold uppercase tracking-[0.2em] text-oro">Pichilemu · Región de O'Higgins</span>
            <h2 class="font-cormorant text-5xl font-semibold leading-[0.95] tracking-tight text-white md:text-7xl">Presencia regional</h2>
          </div>
          <p class="max-w-xl text-base leading-relaxed text-white/80 lg:col-span-5 lg:pb-1">
            Litigación, análisis jurídico y conversación pública desde Pichilemu para toda la Provincia de Cardenal Caro.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <article class="flex flex-col justify-between bg-white p-6 text-[#1a1a1a] sm:p-8 lg:col-span-7 lg:p-10">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-bold uppercase tracking-[0.16em]">
                <span class="text-oro-oscuro">Responsabilidad civil</span>
                <span class="text-[#5b4630]">Sentencia destacada · Octubre 2026</span>
              </div>

              <div class="my-8 flex flex-wrap items-end gap-x-4 gap-y-1 border-y border-[#1a1a1a]/15 py-6">
                <span class="font-cormorant text-7xl font-semibold leading-[0.78] tracking-[-0.04em] text-[#1a1a1a] sm:text-8xl">$299,6</span>
                <span class="pb-1 text-xs font-bold uppercase tracking-[0.24em] text-oro-oscuro">Millones</span>
              </div>

              <h3 class="max-w-2xl font-cormorant text-3xl font-semibold leading-tight text-[#1a1a1a] sm:text-4xl">
                <a
                  href="https://www.diarioelmarino.cl/2026/10/16/juzgado-de-pichilemu-condena-a-conductor-y-propietario-de-camioneta-a-pagar-casi-300-millones-por-atropello-fatal/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-oro/0 decoration-2 underline-offset-4 transition-colors duration-200 hover:text-oro-oscuro hover:decoration-oro focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro-oscuro"
                >
                  Condena a conductor y propietario de camioneta por atropello fatal en Pichilemu
                </a>
              </h3>
              <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#3f3f3f]">
                En una causa dirigida por nuestra firma, el Juzgado de Letras de Pichilemu acogió íntegramente la demanda y fijó una indemnización de <strong>$299.622.440</strong>, más reajustes e intereses, por lucro cesante y daño moral.
              </p>
            </div>

            <div class="mt-8 flex flex-col gap-2 border-t border-[#1a1a1a]/15 pt-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
              <span class="mr-auto text-xs font-bold uppercase tracking-[0.14em] text-[#5b4630]">Cobertura de prensa</span>
              <a
                href="https://www.diarioelmarino.cl/2026/10/16/juzgado-de-pichilemu-condena-a-conductor-y-propietario-de-camioneta-a-pagar-casi-300-millones-por-atropello-fatal/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-oro-oscuro underline decoration-oro/60 underline-offset-4 transition-colors duration-200 hover:text-[#1a1a1a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro-oscuro"
              >
                Diario El Marino <span aria-hidden="true">↗</span>
              </a>
              <a
                href="https://www.expresodelacosta.cl/noticia/justicia-por-fatal-atropello-en-pichilemu-condenan-a-conductor-y-dueno-de-camioneta-a-pagar-mas-de-299-millones"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-oro-oscuro underline decoration-oro/60 underline-offset-4 transition-colors duration-200 hover:text-[#1a1a1a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro-oscuro"
              >
                Expreso de la Costa <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <article class="flex flex-col justify-between border border-oro/35 bg-[#181a1f] p-6 text-white sm:p-8 lg:col-span-5 lg:p-10">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-bold uppercase tracking-[0.16em]">
                <span class="text-oro">Radio Corporación</span>
                <span class="text-white/75">Pichilemu</span>
              </div>

              <div class="mt-7 flex items-end gap-3">
                <span class="font-cormorant text-8xl font-semibold leading-[0.75] tracking-[-0.05em] text-oro sm:text-9xl">97.7</span>
                <span class="pb-1 text-sm font-bold uppercase tracking-[0.2em] text-white">FM</span>
              </div>

              <div class="radio-wave my-8 flex h-16 items-center gap-2" aria-hidden="true">
                <span class="h-6"></span>
                <span class="h-10 [animation-delay:-100ms]"></span>
                <span class="h-14 [animation-delay:-200ms]"></span>
                <span class="h-8 [animation-delay:-300ms]"></span>
                <span class="h-16 [animation-delay:-400ms]"></span>
                <span class="h-12 [animation-delay:-500ms]"></span>
                <span class="h-7 [animation-delay:-600ms]"></span>
                <span class="h-14 [animation-delay:-700ms]"></span>
                <span class="h-9 [animation-delay:-800ms]"></span>
                <span class="h-12 [animation-delay:-900ms]"></span>
                <span class="h-6 [animation-delay:-1000ms]"></span>
              </div>

              <h3 class="font-cormorant text-3xl font-semibold leading-tight text-white sm:text-4xl">«La Ley sin Letra Chica»</h3>
              <p class="mt-3 text-base font-semibold leading-relaxed text-oro">¿Por qué nadie lo ha dicho antes?</p>
              <p class="mt-4 text-base leading-relaxed text-white/80">
                Rafael Pérez Maldonado y Germán Rojas López analizan casos reales y responden consultas jurídicas de la región.
              </p>
              <p class="mt-4 border-l border-oro pl-4 text-sm font-bold uppercase leading-relaxed tracking-[0.12em] text-white">
                Miércoles y viernes<br />11:30 horas
              </p>
            </div>

            <div class="mt-8">
              <a
                href="https://www.radiocorporacionpichilemu.net/"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-14 w-full items-center justify-center gap-3 bg-oro px-5 py-3 text-center text-sm font-bold text-tinta no-underline transition-colors duration-200 hover:bg-oro-claro focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro-claro"
                aria-label="Escuchar Radio Corporación 97.7 FM en vivo, en una pestaña nueva"
              >
                <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="m10 8 6 4-6 4Z" fill="currentColor" stroke="none"></path>
                </svg>
                Escuchar señal en vivo
                <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </a>
              <a
                href="https://radio.garden/listen/radio-corporacion-pichilemu-97-7-fm/5txg3gi4?hl=es"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex min-h-11 w-full items-center justify-center gap-2 text-sm font-semibold text-white/85 underline decoration-oro/60 underline-offset-4 transition-colors duration-200 hover:text-oro-claro focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-oro"
              >
                Alternativa para celular: Radio Garden <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Áreas de Práctica -->
    <section id="areas" class="py-12 bg-white">
      <div class="text-center max-w-3xl mx-auto mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-oro-oscuro block mb-1">Especialización Jurídica</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Áreas de Práctica</h2>
        <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-3"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <div class="relative h-92 overflow-hidden group cursor-pointer">
          <img src="/fotos/area-civil.webp" alt="" width="800" height="437" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">01 / Civil</span>
            <h3 class="text-white text-xl font-semibold mb-2">Litigación Civil</h3>
            <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
            <ul class="text-white/90 text-xs space-y-1 opacity-90">
              <li>• Particiones de herencias y comunidades</li>
              <li>• Expropiaciones e indemnizaciones</li>
              <li>• Responsabilidad contractual y extracontractual</li>
              <li>• Controversias sobre inmuebles y bienes</li>
            </ul>
          </div>
        </div>

        <div class="relative h-92 overflow-hidden group cursor-pointer">
          <img src="/fotos/area-penal.webp" alt="" width="600" height="439" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">02 / Penal</span>
            <h3 class="text-white text-xl font-semibold mb-2">Litigación Penal &amp; Compliance</h3>
            <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
            <ul class="text-white/90 text-xs space-y-1 opacity-90">
              <li>• Litigios penales de alta complejidad</li>
              <li>• Delitos económicos, societarios y tributarios</li>
              <li>• Querellas criminales y defensa penal</li>
              <li>• Modelos de prevención del delito (Compliance)</li>
            </ul>
          </div>
        </div>

        <div class="relative h-92 overflow-hidden group cursor-pointer">
          <img src="/fotos/area-publico.webp" alt="" width="720" height="420" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">03 / Público</span>
            <h3 class="text-white text-xl font-semibold mb-2">Derecho Público &amp; Administrativo</h3>
            <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
            <ul class="text-white/90 text-xs space-y-1 opacity-90">
              <li>• Contencioso administrativo y sanciones</li>
              <li>• Recursos de protección y amparo</li>
              <li>• Contratación pública (ChileCompra)</li>
              <li>• Sumarios disciplinarios y régimen municipal</li>
            </ul>
          </div>
        </div>

        <div class="relative h-92 overflow-hidden group cursor-pointer">
          <img src="/fotos/area-laboral.webp" alt="" width="900" height="592" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">04 / Laboral</span>
            <h3 class="text-white text-xl font-semibold mb-2">Litigación Laboral</h3>
            <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
            <ul class="text-white/90 text-xs space-y-1 opacity-90">
              <li>• Juicios laborales de alta cuantía indemnizatoria</li>
              <li>• Accidentes laborales y enfermedades profesionales</li>
              <li>• Tutela laboral de derechos fundamentales</li>
              <li>• Desvinculaciones de alta dirección y ejecutivos</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Socios -->
    <section id="equipo" class="py-14 bg-slate-50 border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-oro-oscuro block mb-1">Dirección Jurídica &amp; Litigación</span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Socios del Estudio</h2>
          <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-3"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl mx-auto">
          <article class="bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm flex flex-col">
            <div class="relative h-96 w-full overflow-hidden bg-slate-900">
              <img src="/fotos/foto_gerente.webp" alt="Rafael Pérez Maldonado" width="716" height="718" loading="lazy" decoding="async" class="w-full h-full object-cover object-top block" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <h3 class="text-white text-xl font-bold leading-tight">Rafael Pérez Maldonado</h3>
                <span class="text-[#C5A880] text-xs font-semibold uppercase tracking-wider block mt-1">Socio Fundador &bull; Director de Litigios</span>
              </div>
            </div>
            <div class="p-6 flex flex-col flex-1 justify-between">
              <div>
                <span class="text-xs font-bold text-slate-800 block mb-2">Magíster en Derecho Público y Constitucional</span>
                <p class="text-xs text-slate-600 leading-relaxed mb-4 text-justify">
                  Más de 15 años de ejercicio profesional. Especialista en responsabilidad civil contractual y extracontractual, derecho público, administrativo y derecho penal general.
                </p>
              </div>
              <div class="pt-4 border-t border-slate-200 mt-6 flex justify-between items-center text-xs">
                <a href="mailto:rafael@rpabogados.cl" class="text-slate-600 hover:text-oro-oscuro font-medium">rafael@rpabogados.cl</a>
              </div>
            </div>
          </article>

          <article class="bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm flex flex-col">
            <div class="relative h-96 w-full overflow-hidden bg-slate-900">
              <img src="/fotos/yerko-scheihing.webp" alt="Yerko Scheihing Sepúlveda" width="640" height="640" loading="lazy" decoding="async" class="w-full h-full object-cover object-top block" />
