    var navLinks = document.querySelectorAll('a');
    for (var k = 0; k < navLinks.length; k++) {
      var txt = (navLinks[k].textContent || '').toUpperCase();
      if (txt.indexOf('PICHILEMU') !== -1 && !navLinks[k].id) {
        navLinks[k].setAttribute('href', '#sede-pichilemu');
      }
    }

    // 2. Dejar únicamente "ENVIAR" en el botón del formulario de contacto
    var submitBtns = document.querySelectorAll('#contacto button[type="submit"], #contacto button');
    for (var b = 0; b < submitBtns.length; b++) {
      var btnTxt = (submitBtns[b].textContent || '').toUpperCase();
      if (btnTxt.indexOf('ENVIAR') !== -1) {
        submitBtns[b].textContent = 'ENVIAR';
      }
    }

    // 3. Base de fallos con enlaces profundos verificados e imágenes locales autorizadas ('self')
    var poolFallos = [
      {
        cat: 'Indemnizaciones',
        tag: 'Fallo Clave',
        title: 'Los jueces ya no pueden rebajar indemnizaciones «al ojo»: tienen que fundamentar cada peso',
        desc: 'La justicia fijó un criterio claro: si un juez decide bajar el monto que una persona pide por daño moral, no puede escudarse en frases vagas.',
