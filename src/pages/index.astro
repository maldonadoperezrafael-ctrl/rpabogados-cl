<script>
  // 1. Modificar el texto del botón del formulario a "Envía tu Consulta"
  document.querySelectorAll('#form-contacto button, #form-contacto input[type="submit"]').forEach((btn) => {
    if (btn.tagName === 'INPUT') {
      btn.setAttribute('value', 'Envía tu Consulta');
    } else {
      btn.textContent = 'Envía tu Consulta';
    }
  });

  // 3. Pool de fallos basado en texto puro
  const poolFallos = [
    { cat: 'Indemnizaciones', tag: 'Fallo Clave', title: 'Los jueces ya no pueden rebajar indemnizaciones «al ojo»: tienen que fundamentar cada peso', desc: 'La justicia fijó un criterio claro: si un juez decide bajar el monto que una persona pide por daño moral, no puede escudarse en frases vagas.', url: 'https://www.diarioconstitucional.cl/videos/jueces-deben-explicar-fundadamente-por-que-reducen-el-monto-de-la-indemnizacion-de-perjuicios-por-dano-moral-mas-alla-de-una-somera-debilidad-probatoria/', source: 'Diario Constitucional' },
    { cat: 'Redes Sociales', tag: 'Corte Suprema', title: 'La Suprema frena las «funas» en internet: prohibido acusar de delitos sin pruebas en redes', desc: 'El máximo tribunal le puso límites a las denuncias en redes sociales. Nadie puede acusar a otra persona de un delito sin una condena judicial que lo demuestre.', url: 'https://www.diarioconstitucional.cl/2026/04/21/corte-suprema-pone-freno-a-acusaciones-de-delitos-sin-respaldo-difundidas-en-redes-sociales/', source: 'Diario Constitucional' },
    { cat: 'Libertad de Prensa', tag: 'Rol N° 7808-2026', title: 'No se pueden borrar noticias de juicios pasados invocando el «derecho al olvido»', desc: 'La Suprema rechazó el reclamo de quienes pedían eliminar de internet noticias sobre antiguos juicios. Si la información fue real y de interés público, el derecho a informar está primero.', url: 'https://www.diarioconstitucional.cl/2026/06/16/corte-suprema-descarta-eliminar-noticias-invocando-el-derecho-al-olvido/', source: 'Diario Constitucional' },
    { cat: 'Responsabilidad Civil', tag: 'Juzgado de Pichilemu', title: 'Juzgado de Pichilemu condena a conductor y propietario de camioneta a pagar casi 300 millones por atropello fatal', desc: 'El tribunal acogió íntegramente la demanda indemnizatoria de perjuicios por lucro cesante y daño moral, estableciendo la responsabilidad solidaria del propietario del vehículo.', url: 'https://www.diarioelmarino.cl/2026/10/16/juzgado-de-pichilemu-condena-a-conductor-y-propietario-de-camioneta-a-pagar-casi-300-millones-por-atropello-fatal/', source: 'Diario El Marino' },
    { cat: 'Derecho de Daños', tag: 'Cardenal Caro', title: 'Justicia por fatal atropello en Pichilemu: condenan a conductor y dueño de camioneta a pagar más de $299 millones', desc: 'Fallo ejemplar establece indemnización integral por daño moral y lucro cesante a favor de la familia afectada tras acreditar las infracciones viales.', url: 'https://www.expresodelacosta.cl/noticia/justicia-por-fatal-atropello-en-pichilemu-condenan-a-conductor-y-dueno-de-camioneta-a-pagar-mas-de-299-millones', source: 'Expreso de la Costa' },
    { cat: 'Derecho Inmobiliario', tag: 'Ley N° 21.633', title: 'Reflexiones sobre la Ley N° 21.633 que regula los delitos de ocupación ilegal de inmuebles y restitución anticipada', desc: 'Análisis de la configuración de flagrancia permanente en usurpaciones y la solicitud de desalojo provisorio del inmueble ante el juez de garantía.', url: 'https://www.diarioconstitucional.cl/articulos/algunas-reflexiones-sobre-la-nueva-ley-n-21-633-que-regula-los-delitos-de-ocupacion-ilegal-de-inmuebles-y-los-efectos-de-la-medida-cautelar-real-especial-incorporada-en-dicho-articulado/', source: 'Diario Constitucional' }
  ];

  const DIEZ_DIAS_MS = 1000 * 60 * 60 * 24 * 10;
  const ciclo = Math.floor(Date.now() / DIEZ_DIAS_MS);
  let currentIndex = (ciclo * 3) % poolFallos.length;

  function renderFallos() {
    for (let i = 0; i < 3; i++) {
      const item = poolFallos[(currentIndex + i) % poolFallos.length];
      const catEl = document.getElementById('news-cat-' + i);
      const tagEl = document.getElementById('news-tag-' + i);
      const linkEl = document.getElementById('news-link-' + i);
      const descEl = document.getElementById('news-desc-' + i);
      const srcEl = document.getElementById('news-source-' + i);
      const moreEl = document.getElementById('news-more-' + i);

      if (catEl && tagEl && linkEl && descEl) {
        catEl.textContent = item.cat;
        tagEl.textContent = item.tag;
        linkEl.textContent = item.title;
        linkEl.setAttribute('href', item.url);
        descEl.textContent = item.desc;
        if (srcEl) srcEl.textContent = item.source;
        if (moreEl) moreEl.setAttribute('href', item.url);
      }
    }
  }

  renderFallos();

  const assetBtnRotar = document.getElementById('btn-rotar-fallos');
  if (assetBtnRotar) {
    assetBtnRotar.addEventListener('click', () => {
      currentIndex = (currentIndex + 3) % poolFallos.length;
      renderFallos();
    });
  }
</script>
