        url: 'https://www.diarioconstitucional.cl/2026/04/21/corte-suprema-pone-freno-a-acusaciones-de-delitos-sin-respaldo-difundidas-en-redes-sociales/',
        source: 'Diario Constitucional',
        img: '/fotos/area-penal.webp'
      },
      {
        cat: 'Libertad de Prensa',
